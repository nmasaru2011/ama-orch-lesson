{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "LessonApplication (H2 開発)",
            "request": "launch",
            "console": "integratedTerminal",
            "mainClass": "com.amaorchnsuaru.manager.lesson.LessonApplication",
            "projectName": "manager",
            "classPaths": [
                "${workspaceFolder}/ama-orch-web/target/classes",
                "${workspaceFolder}/ama-orch-web/target/dependency/*"
            ],
            "modulePaths": [],
            "preLaunchTask": "ama-orch-web: Prepare Spring Boot debug",
            "envFile": "${workspaceFolder}/ama-orch-web/.env"
        },
        {
            "type": "java",
            "name": "LessonApplication (PostgreSQL テスト)",
            "request": "launch",
            "console": "integratedTerminal",
            "mainClass": "com.amaorchnsuaru.manager.lesson.LessonApplication",
            "projectName": "manager",
            "classPaths": [
                "${workspaceFolder}/ama-orch-web/target/classes",
                "${workspaceFolder}/ama-orch-web/target/dependency/*"
            ],
            "modulePaths": [],
            "preLaunchTask": "ama-orch-web: Prepare Spring Boot debug",
            "envFile": "${workspaceFolder}/ama-orch-web/.env.postgres"
        },
        {
            "type": "node",
            "name": "ama-orch データエディター（Electron）",
            "request": "launch",
            "cwd": "${workspaceFolder}/ama-orch-data-editor",
            "runtimeExecutable": "${workspaceFolder}/ama-orch-data-editor/node_modules/electron/dist/electron.exe",
            "runtimeArgs": [
                "--inspect=5858",
                "${workspaceFolder}/ama-orch-data-editor"
            ],
            "env": {
                "VITE_DEV_SERVER_URL": "http://127.0.0.1:5173"
            },
            "preLaunchTask": "ama-orch: Start Vite (Electron)",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}