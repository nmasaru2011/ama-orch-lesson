{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ama-orch-web: Prepare Spring Boot debug",
            "type": "shell",
            "command": "mvn -q -DskipTests compile dependency:copy-dependencies -DincludeScope=runtime -DoutputDirectory=target/dependency",
            "options": {
                "cwd": "${workspaceFolder}/ama-orch-web"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "ama-orch: Compile Electron",
            "type": "shell",
            "command": "npx tsc",
            "options": {
                "cwd": "${workspaceFolder}/ama-orch-data-editor"
            },
            "problemMatcher": "$tsc"
        },
        {
            "label": "ama-orch: Start Vite (Electron)",
            "type": "shell",
            "command": "npm run dev:renderer",
            "options": {
                "cwd": "${workspaceFolder}/ama-orch-data-editor"
            },
            "isBackground": true,
            "dependsOn": "ama-orch: Compile Electron",
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE v",
                    "endsPattern": "Local:"
                }
            }
        }
    ]
}