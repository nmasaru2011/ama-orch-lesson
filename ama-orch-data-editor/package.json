{
    "name": "ama-orch-data-editor",
    "version": "0.1.0",
    "private": true,
    "description": "Offline desktop 3D data editor for ama-orch JSON files",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
        "tauri:dev": "npm run dev",
        "dev:renderer": "vite --config electron.vite.config.ts --host 127.0.0.1",
        "build": "tsc && vite --config electron.vite.config.ts build && electron-builder",
        "preview": "vite --config electron.vite.config.ts preview",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@vitejs/plugin-basic-ssl": "^1.1.0",
        "sql.js": "^1.13.0",
        "three": "^0.180.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/sql.js": "^1.4.9",
        "@types/three": "^0.180.0",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "electron": "^37.2.6",
        "electron-builder": "^26.0.12",
        "typescript": "^5.7.2",
        "vite": "^6.0.7",
        "wait-on": "^8.0.1"
    },
    "build": {
        "appId": "jp.amaorchnsuaru.dataeditor",
        "productName": "ama-orch Data Editor",
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "nsis"
        }
    }
}